{
  "name": "anime-tracker",
  "version": "2.0.0",
  "description": "Turns your Crunchyroll watch history into a self-updating watch list: what to watch next, new seasons, recommendations and viewing stats. Runs locally or on Cloudflare.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "enrich": "node scripts/enrich_anilist.js",
    "prefetch-images": "node scripts/prefetch_images.js",
    "optimize-images": "node scripts/optimize_images.js && node scripts/optimize_episode_thumbs.js",
    "repair-split-cours": "node scripts/repair_split_cours.js",
    "dev:cloudflare": "env -u CLOUDFLARE_API_TOKEN wrangler dev",
    "deploy": "env -u CLOUDFLARE_API_TOKEN wrangler deploy",
    "cf:login": "env -u CLOUDFLARE_API_TOKEN wrangler login",
    "migrate:cloudflare": "node scripts/migrate_to_cloudflare.js",
    "backup": "node scripts/backup.js download",
    "ext:package": "node scripts/package-extension.mjs",
    "cws:status": "node scripts/cws.mjs fetch-status",
    "cws:publish": "node scripts/cws.mjs upload-and-publish",
    "ext:assets": "node scripts/store-assets.mjs"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.0.3",
    "aws4fetch": "1.0.20",
    "better-sqlite3": "^13.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "wrangler": "^4.149.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/okturan/anime-tracker.git"
  },
  "keywords": [
    "anime",
    "crunchyroll",
    "anilist",
    "myanimelist",
    "watchlist",
    "cloudflare-workers",
    "durable-objects",
    "chrome-extension"
  ]
}
