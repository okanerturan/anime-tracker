{
  "manifest_version": 3,
  "name": "Anime Tracker: Crunchyroll Sync",
  "version": "1.9.1",
  "description": "Keeps your local anime tracker up to date with your Crunchyroll watch history.",
  "permissions": [
    "alarms",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://www.crunchyroll.com/*",
    "https://graphql.anilist.co/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.crunchyroll.com/*"
      ],
      "js": [
        "crunchyroll-api.js",
        "page-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.crunchyroll.com/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.crunchyroll.com/*"
      ],
      "js": [
        "cr-overlay.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Anime Tracker sync",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon-32.png"
      ],
      "matches": [
        "https://www.crunchyroll.com/*"
      ]
    }
  ]
}
