# Values come from a file outside the repository (this repository is public).
# ~/.config/anime-tracker/hub.env holds ORIGIN_SECRET=… (chmod 600; the Worker has the same value) and
# TMDB_API_READ_ACCESS_TOKEN=… (TMDB's v4 read token, for episode titles and stills).
ORIGIN_SECRET=$(grep '^ORIGIN_SECRET=' ~/.config/anime-tracker/hub.env | cut -d= -f2-)
TMDB_API_READ_ACCESS_TOKEN=$(grep '^TMDB_API_READ_ACCESS_TOKEN=' ~/.config/anime-tracker/hub.env | cut -d= -f2-)
